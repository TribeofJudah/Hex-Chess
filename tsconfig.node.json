// Node-side config files: Node built-ins resolve normally (no "bundler" mode).
// Everything else is covered by the root tsconfig.json.
{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["vite.config.ts", "eslint.config.js"]
}
